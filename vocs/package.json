{
  "name": "vocs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run fetch-releases && vp run fetch-benchmarks && vp exec vocs build",
    "check": "vp check",
    "check-links": "vp exec tsx check-links.ts",
    "dev": "vp exec vocs dev",
    "fetch-benchmarks": "vp exec tsx scripts/fetch-benchmarks.ts",
    "fetch-releases": "vp exec tsx scripts/fetch-releases.ts",
    "preview": "vp run build && vp exec vocs preview"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vocs": "1.0.13"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "tsx": "4.21.0",
    "typescript": "~6.0.3",
    "vite": "6.3.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.25.0"
}
